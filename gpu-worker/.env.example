NYANKOFACE_URL=http://gateway:8090
NYANKOFACE_API_PREFIX=runner-api
WORKER_NAME=gpu-worker
WORKER_PUBLIC_URL=http://localhost:8787
WORKER_DATA_DIR=/data
WORKER_DOCKER_NETWORK=nyankoface-gpu-worker
WORKER_RUNTIME_PROFILE_PATH=./gpu-worker/runtime-profile.example.json
WORKER_RUNTIME_PROFILE_FILE=/run/nyankoface/runtime-profile.json
WORKER_POLL_SECONDS=5
MAX_GPU_JOBS=1
NYANKOFACE_VERIFY_TLS=true
NYANKOFACE_WORKER_FAKE_EXECUTOR=false
